{
 "record": "plugin-walltime",
 "release": "v0.6.0",
 "date": "2026-11-19",
 "scope": "Wall time of one annotation run per plugin on the genome-wide ClinVar dataset of each assembly, Ensembl VEP and vep-rs on the same machine, beside a run without a plugin and the same run under --hgvs. The plugins are those the support table of docs/plugins.md marks verified on real data; a plugin whose data cannot be redistributed and TranscriptAnnotator, which reads a table of the user's own, are not timed.",
 "arches": [
  {
   "arch": "arm64",
   "instance_type": "c9gd.8xlarge",
   "cpu": "AWS Graviton5",
   "host_vcpu_count": 32,
   "host_memory_gib": 64,
   "local_nvme": true
  },
  {
   "arch": "x86_64",
   "instance_type": "c8id.8xlarge",
   "cpu": "Intel x86_64",
   "host_vcpu_count": 32,
   "host_memory_gib": 64,
   "local_nvme": true
  }
 ],
 "datasets": {
  "GRCh37": {
   "label": "ClinVar",
   "variants": 4388172
  },
  "GRCh38": {
   "label": "ClinVar",
   "variants": 4398127
  }
 },
 "engines": {
  "ensembl-vep": {
   "name": "Ensembl VEP",
   "version": "116.2",
   "image": "ensemblorg/ensembl-vep:release_116.2",
   "digest": "sha256:5c57abdc40b637cac198370b4c114777fa24de3336141fdf09d2b0c43cd4b8da",
   "loftee_image_added": "libcurl3-gnutls=7.81.0-1ubuntu1.30,libhts3=1.13+ds-2build1,libhtscodecs2=1.1.1-3,samtools=1.13-4",
   "arguments": "vep -i <input> -o <output> --offline --cache --dir_cache <cache> --cache_version 116 --species homo_sapiens --assembly <assembly> --format vcf --buffer_size 5000 --fork 16 --fasta <fasta> --no_headers --stats_text --quiet --force_overwrite <the row's arguments>",
   "warm_state": "its inputs read once and a one-record run made before the timed run",
   "discarded_full_runs": 0
  },
  "vep-rs": {
   "name": "vep-rs",
   "version": "v0.6.0",
   "binary_sha256": {
    "arm64": "6659ec5737bd8c39181507ae05a76a0078d55fd8ba3f3ddbd40e26ce23943f99",
    "x86_64": "cc47d37b18677c872771e65fd08abe14d8b627f1638bc23b609787154ead714f"
   },
   "arguments": "vep -i <input> -o <output> --offline --json_cache <cache> --species homo_sapiens --assembly <assembly> --format vcf --fork 16 --buffer_size 5000 --no_stats --quiet --force_overwrite <the row's arguments> --fasta <fasta>",
   "warm_state": "its inputs read once, a one-record run and one full run made and discarded before the timed runs",
   "discarded_full_runs": 1
  }
 },
 "methodology_note": "One machine per row and architecture, nothing else running on it, every input on its local NVMe instance store; the two engines ran one after the other. The timed span is the engine's process alone, stamped just before it starts and just after it exits, inside the container for Ensembl VEP. Each run's output was hashed and deleted before the next run. wall_seconds lists every timed run of the engine on the row and architecture in run order: one for Ensembl VEP; for vep-rs five on the rows without a plugin and on LoFTEE and one on every other row. The figure of a row is the median of its list. LoFTEE's rows load LoFTEE's module as --plugin LoF with stand-ins for the MaxEntScan files it bundles, and Ensembl VEP's run of them is on its image with the packages of loftee_image_added. A row's arguments name its files as scripts/concordance/plugin_gate_runs.toml does. output_rows is the count of data rows both engines wrote.",
 "loftee_note": "Ensembl VEP ran LoFTEE's module with stand-ins for the MaxEntScan files it bundles, on its image with samtools added.",
